{
  "manifest_version": 3,
  "name": "You2Bi · YouTube 登录同步",
  "version": "1.0.1",
  "description": "将当前 Edge 配置中的 YouTube 登录状态同步到本机 You2Bi。",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "alarms", "storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"],
  "background": {"service_worker": "sync.js"},
  "icons": {"128": "you2bi-icon.png"},
  "action": {"default_icon": "you2bi-icon.png", "default_title": "You2Bi：点击启用或暂停 YouTube 登录同步"}
}
